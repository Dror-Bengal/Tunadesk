{
  "description": "Tunadesk: briefing at session start, nudge to update the desk after edits",
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/session-start.sh\"", "timeout": 10 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/stop-nudge.sh\"", "timeout": 10 }] }
    ]
  }
}
