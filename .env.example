# Copy to .env and fill in. `.env` is git-ignored.

# Required: the web UI asks for this; generate with `openssl rand -hex 24`.
TUNADESK_ADMIN_TOKEN=

# The URL agents on other machines use to reach the desk (shown in setup snippets and wake-up prompts).
# LAN: http://your-mac.local:4545 · Tailscale: http://your-mac.tailnet.ts.net:4545 · VPS: https://desk.example.com
TUNADESK_PUBLIC_URL=http://localhost:4545

# Optional: keep data in a host folder instead of a Docker volume.
# TUNADESK_DATA=/Users/you/.tunadesk

# Optional: host port.
# TUNADESK_PORT=4545
